<!doctype html>
<html lang="ru">
<head>
    <link rel="stylesheet" href="Custom.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BOT Fader</title>
</head>
<body>
  <div class="page">
    <header>
      <div class="brand">
        <span class="brand-bot">BOT</span>
        <span>Faider</span>
      </div>

      <nav>
        <a href="#">Главная</a>
        <a href="#">Профиль</a>
        <a href="#">Топ 100</a>
      </nav>

      <div class="socials" aria-label="Социальные сети">
        <span>ᴠκ</span>
        <span>➤</span>
      </div>
    </header>

    <main>
      <section class="left">
        <article class="card buy-card">
          <div class="card-title">
            <span class="round-icon crown">♛</span>
            <span>Покупка доната</span>
          </div>

          <form class="buy-form">
            <input type="text" placeholder="Ссылка профиля / Ваш id">
            <select aria-label="Выберите товар">
              <option selected>Товар</option>
              <option>Подписка</option>
              <option>Игровая валюта</option>
            </select>
            <button type="button">Купить</button>
          </form>
        </article>

        <article class="card donate-card">
          <div class="card-title">
            <span class="round-icon crown">♛</span>
            <span>Описание доната</span>
          </div>

          <div class="donate-list">
            <div class="donate-option">
              <span class="round-icon">◉</span>
              <span>“ВК” статус</span>
              <span class="arrow">⌄</span>
            </div>
            <div class="donate-option">
              <span class="round-icon">♟</span>
              <span>“DRIM” статус</span>
              <span class="arrow">⌄</span>
            </div>
            <div class="donate-option">
              <span class="round-icon"></span>
              <span>“СМАРТ” статус</span>
              <span class="arrow">⌄</span>
            </div>
            <div class="donate-option">
              <span class="round-icon">▤</span>
              <span>“ДОШИРАК” бизнес</span>
              <span class="arrow">⌄</span>
            </div>
            <div class="donate-option">
              <span class="round-icon">◈</span>
              <span>Донат-изумрудов</span>
              <span class="arrow">⌄</span>
            </div>
            <div class="donate-option">
              <span class="round-icon">＄</span>
              <span>Игровая валюта</span>
              <span class="arrow">⌄</span>
            </div>
          </div>
        </article>
      </section>

      <aside class="right">
        <section class="card status-card">
          <div class="card-title">
            <span class="round-icon">↗</span>
            <span>Статистика Бота</span>
          </div>

          <div class="status-list">
            <div class="status-row">
              <span class="status-label"><span class="status-emoji">▢</span>Сообщений</span>
              <span>-</span>
            </div>
            <div class="status-row">
              <span class="status-label"><span class="status-emoji">♟</span>Игроков</span>
              <span>-</span>
            </div>
            <div class="status-row">
              <span class="status-label"><span class="status-emoji">🎮</span>Онлайн</span>
              <span>-</span>
            </div>
          </div>
        </section>

        <section class="card links-card">
          <div class="link-item">
            <span class="link-icon">ᴠκ</span>
            <span>Играть | Группа</span>
          </div>
          <div class="link-item">
            <span class="link-icon">➤</span>
            <span>Играть | Канал</span>
          </div>
        </section>

        <section class="card news-card">
          <div class="card-title">
            <span class="round-icon">▤</span>
            <span>Новости/обновление</span>
          </div>
          <div class="news-placeholder"></div>
        </section>
      </aside>
    </main>
  </div>
</body>
</html>
